{
  "deployment_mode": "local",
  "business_root": "~/ProjectManagerData",
  "storage_bindings": [
    {
      "binding_id": "business-source",
      "provider": "local",
      "node_id": "local-node",
      "logical_root": "business://business-source/",
      "physical_root": "~/ProjectManagerData",
      "roles": ["source"],
      "readable": true,
      "writable": false,
      "enabled": true
    }
  ],
  "runtime_workspace": "~/.project_manager",
  "database": {
    "provider": "sqlite",
    "sqlite_path": "~/.project_manager/state/project_manager.sqlite3",
    "dsn_env_var": "PROJECT_MANAGER_DATABASE_DSN"
  },
  "providers": {
    "document_store": "local",
    "structure_index": "disabled",
    "pageindex_dir": null,
    "projection_writer": "filesystem",
    "projection_root": "~/.project_manager/projections"
  }
}
