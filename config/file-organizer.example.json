{
  "database_path": "<node-local-runtime>/file-organizer.sqlite3",
  "results_root": "<external-node-local-results-root>",
  "source_binding_id": "incoming",
  "archive_binding_id": "archive",
  "pageindex_min_text_length": 16000,
  "pageindex": {"enabled": false, "directory": "<optional-pageindex-installation>"},
  "bindings": [
    {
      "binding_id": "incoming",
      "provider": "local",
      "node_id": "replace-with-this-node",
      "logical_root": "business://incoming/",
      "physical_root": "<source-binding-root>",
      "roles": ["source"],
      "readable": true,
      "writable": false
    },
    {
      "binding_id": "archive",
      "provider": "local",
      "node_id": "replace-with-this-node",
      "logical_root": "business://archive/",
      "physical_root": "<archive-binding-root>",
      "roles": ["archive"],
      "readable": true,
      "writable": true
    }
  ]
}
