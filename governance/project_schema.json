{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Manager Agent - Tool Schema",
  "description": "31 个工具的 schema 契约。校验注册到 ToolRegistry 的工具参数与文档一致。",
  "version": "1.0.0",
  "tools": {
    "scan_projects": {
      "domain": "project",
      "description": "扫描三阶段目录，返回项目列表",
      "params": {},
      "required": []
    },
    "read_project_record": {
      "domain": "project",
      "description": "读取项目记录.md",
      "params": {
        "project_name": {"type": "string", "description": "项目名称"}
      },
      "required": ["project_name"]
    },
    "check_milestones": {
      "domain": "project",
      "description": "检查里程碑状态(逾期/到期)",
      "params": {
        "project_name": {"type": "string"},
        "days": {"type": "integer", "default": 7}
      },
      "required": []
    },
    "check_deliverables": {
      "domain": "project",
      "description": "核对交付物",
      "params": {
        "project_name": {"type": "string"}
      },
      "required": ["project_name"]
    },
    "archive_files": {
      "domain": "project",
      "description": "智能归档文件",
      "params": {
        "source_dir": {"type": "string"}
      },
      "required": []
    },
    "migrate_project": {
      "domain": "project",
      "description": "迁移项目阶段",
      "params": {
        "project_name": {"type": "string"},
        "to_phase": {"type": "string"},
        "update_status": {"type": "string"}
      },
      "required": ["project_name"]
    },
    "generate_bid_overview": {
      "domain": "project",
      "description": "生成投标进度总览",
      "params": {
        "output_file": {"type": "string"}
      },
      "required": []
    },
    "generate_project_overview": {
      "domain": "project",
      "description": "生成全局项目总览",
      "params": {
        "phase": {"type": "string"}
      },
      "required": []
    },
    "generate_report": {
      "domain": "project",
      "description": "生成项目报告",
      "params": {
        "project_name": {"type": "string"},
        "report_type": {"type": "string"}
      },
      "required": ["project_name"]
    },
    "write_response": {
      "domain": "project",
      "description": "写入响应文件",
      "params": {
        "content": {"type": "string"},
        "filename": {"type": "string"}
      },
      "required": ["content", "filename"]
    },
    "scan_raw_files": {
      "domain": "data_cleaning",
      "description": "扫描原始文件目录",
      "params": {},
      "required": []
    },
    "extract_pdf": {
      "domain": "data_cleaning",
      "description": "提取PDF结构化数据",
      "params": {
        "file_path": {"type": "string"}
      },
      "required": ["file_path"]
    },
    "extract_document": {
      "domain": "data_cleaning",
      "description": "提取 Word/PDF/图片文件的结构化数据",
      "params": {
        "file_path": {"type": "string"}
      },
      "required": ["file_path"]
    },
    "classify_document": {
      "domain": "data_cleaning",
      "description": "根据文件名/内容分类文档",
      "params": {
        "file_path": {"type": "string"}
      },
      "required": ["file_path"]
    },
    "batch_process": {
      "domain": "data_cleaning",
      "description": "批量处理目录文件",
      "params": {
        "source_dir": {"type": "string"}
      },
      "required": []
    },
    "save_structured": {
      "domain": "data_cleaning",
      "description": "保存结构化数据",
      "params": {
        "data": {"type": "object"},
        "output_path": {"type": "string"}
      },
      "required": ["data", "output_path"]
    },
    "process_documents_to_ledger": {
      "domain": "data_cleaning",
      "description": "读取多个源文件，输出结构化提取结果并更新项目总览账本",
      "params": {
        "file_paths": {"type": "array"},
        "project_name": {"type": "string"}
      },
      "required": ["file_paths"]
    },
    "import_project_detail_workbook": {
      "domain": "data_cleaning",
      "description": "读取项目明细表.xlsx，标准化项目字段并更新多个项目总览账本",
      "params": {
        "file_path": {"type": "string"}
      },
      "required": ["file_path"]
    },
    "generate_bid_progress_html": {
      "domain": "data_cleaning",
      "description": "从项目账本生成投标进度总览 HTML 展示页",
      "params": {
        "output_file": {"type": "string"}
      },
      "required": []
    },
    "update_project_ledger": {
      "domain": "data_cleaning",
      "description": "数据清洗及文件整理：将候选事实写入项目总览.md账本并执行规则决议",
      "params": {
        "project_name": {"type": "string"},
        "facts": {"type": "object"},
        "evidence": {"type": "array"},
        "source_type": {"type": "string"}
      },
      "required": []
    },
    "scan_bid_notices": {
      "domain": "opportunity",
      "description": "扫描招标公告目录",
      "params": {},
      "required": []
    },
    "parse_bid_notice": {
      "domain": "opportunity",
      "description": "解析招标公告提取关键字段",
      "params": {
        "file_path": {"type": "string"}
      },
      "required": ["file_path"]
    },
    "check_duplicate": {
      "domain": "opportunity",
      "description": "检测商机是否重复",
      "params": {
        "project_code": {"type": "string"}
      },
      "required": ["project_code"]
    },
    "generate_bid_context": {
      "domain": "opportunity",
      "description": "生成 bid_context.json",
      "params": {
        "parsed_data": {"type": "object"}
      },
      "required": ["parsed_data"]
    },
    "create_crm_suggestion": {
      "domain": "opportunity",
      "description": "生成 CRM 录入建议",
      "params": {
        "bid_context": {"type": "object"}
      },
      "required": ["bid_context"]
    },
    "cloudcc_session_probe": {
      "domain": "cloudcc_crm",
      "description": "检查 CloudCC 登录态和浏览器适配器可用性",
      "params": {},
      "required": []
    },
    "cloudcc_search_record": {
      "domain": "cloudcc_crm",
      "description": "只读查询 CloudCC CRM 对象记录",
      "params": {
        "object_type": {"type": "string"},
        "query": {"type": "string"}
      },
      "required": ["object_type", "query"]
    },
    "cloudcc_duplicate_check": {
      "domain": "cloudcc_crm",
      "description": "基于证据检查 CloudCC 商机是否重复",
      "params": {
        "project_code": {"type": "string"},
        "project_name": {"type": "string"},
        "customer": {"type": "string"}
      },
      "required": []
    },
    "cloudcc_prepare_opportunity_draft": {
      "domain": "cloudcc_crm",
      "description": "根据 bid_context 准备 CRM 商机草稿（不写入）",
      "params": {
        "bid_context": {"type": "object"}
      },
      "required": ["bid_context"]
    },
    "cloudcc_fill_draft_gated": {
      "domain": "cloudcc_crm",
      "description": "受控填充 CRM 草稿并在提交前停止",
      "params": {
        "draft": {"type": "object"}
      },
      "required": ["draft"]
    },
    "cloudcc_readback_record": {
      "domain": "cloudcc_crm",
      "description": "提交后回读 CloudCC CRM 记录并校验字段",
      "params": {
        "record_id": {"type": "string"},
        "record_url": {"type": "string"}
      },
      "required": []
    }
  },
  "validation_rules": [
    {
      "id": "TOOL-001",
      "level": "error",
      "check": "schema 声明的工具必须可注册到 debug_all_tools ToolRegistry；运行时只暴露 active skill 的工具子集",
      "expected_count": 31
    },
    {
      "id": "TOOL-002",
      "level": "error",
      "check": "required 参数必须在 ToolRegistry.register() 的 required 列表里",
      "fix": "在 main.py 的 _build_registry() 中检查 required 参数"
    },
    {
      "id": "TOOL-003",
      "level": "warning",
      "check": "description 应该跟 references/project_tools.md 一致",
      "fix": "同步更新文档或代码"
    }
  ]
}
