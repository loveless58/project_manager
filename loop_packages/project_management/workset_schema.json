{
  "schema_version": "agentplatform.workset_schema.v1",
  "workset_schema_version": "project_management.workset.v1",
  "description": "Minimal project-management workset contract.",
  "required_top_level": ["schema_version", "task_type", "inputs", "permission_boundary", "done_when"],
  "properties": {
    "schema_version": {"const": "project_management.workset.v1"},
    "task_type": {"enum": ["status_rollup", "risk_check", "report_generation", "migration"]},
    "inputs": {"required": []},
    "permission_boundary": {"required": ["external_write_allowed", "requires_human_confirmation"]},
    "done_when": {"required_items": ["project_state_read", "response_written"]}
  }
}
